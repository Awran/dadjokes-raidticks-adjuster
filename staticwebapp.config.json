{
  "routes": [
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/assets/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*.{css,scss,js,png,gif,ico,jpg,svg,woff,woff2,ttf,eot}",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/pending",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/pending.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/bot/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/pending", "/pending.html", "/*.{css,scss,js,png,gif,ico,jpg,svg,woff,woff2,ttf,eot}"]
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript"
  },
  "platform": {
    "apiRuntime": "node:18"
  }
}
